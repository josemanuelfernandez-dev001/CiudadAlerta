<form class="panel filter-grid" method="GET" action="<%= action %>">
  <% if (showZona !== false) { %>
    <div>
      <label for="zona">Zona</label>
      <input id="zona" type="text" name="zona" placeholder="Ej. Las Panosas" value="<%= filtros?.zona || '' %>" />
    </div>
  <% } %>

  <div>
    <label for="estado">Estado</label>
    <select id="estado" name="estado">
      <option value=""><%= allStatesLabel || 'Todos los estados' %></option>
      <% ['pendiente', 'en_proceso', 'resuelto', 'rechazado'].forEach(estado => { %>
        <option value="<%= estado %>" <%= filtros?.estado === estado ? 'selected' : '' %>>
          <%= estado.replace('_', ' ') %>
        </option>
      <% }) %>
    </select>
  </div>

  <div>
    <label for="categoria_id">Categoría</label>
    <select id="categoria_id" name="categoria_id">
      <option value="">Todas</option>
      <% (categorias || []).forEach(c => { %>
        <option value="<%= c.id %>" <%= String(filtros?.categoria_id || '') === String(c.id) ? 'selected' : '' %>>
          <%= c.nombre %>
        </option>
      <% }) %>
    </select>
  </div>

  <div>
    <label>&nbsp;</label>
    <button class="btn" type="submit"><%= submitLabel || 'Aplicar filtros' %></button>
  </div>
</form>
