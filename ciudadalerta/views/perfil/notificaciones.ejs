<%- include('../layout/citizen-header') %>

<section class="page-shell">
  <header class="page-hero">
    <div>
      <h1>Notificaciones</h1>
      <p>Estado de tus reportes y novedades municipales.</p>
    </div>
  </header>

  <% if (!notifs || notifs.length === 0) { %>
    <section class="panel empty-state">
      <p>No tienes notificaciones por ahora.</p>
    </section>
  <% } else { %>
    <ul class="notif-list">
      <% notifs.forEach(n => { %>
        <li class="notif-item <%= n.leida ? '' : 'new' %>">
          <div>
            <p><strong><%= n.leida ? 'Leída' : 'Nueva' %>:</strong> <%= n.mensaje %></p>
            <% if (n.reportes && n.reportes.titulo) { %>
              <p class="card-meta">Reporte: <a href="/reportes/<%= n.reporte_id %>"><%= n.reportes.titulo %></a></p>
            <% } %>
          </div>
          <% if (!n.leida) { %>
            <form action="/notificaciones/<%= n.id %>/leida" method="POST">
              <button class="btn-secondary" type="submit" aria-label="Marcar como leída">Marcar leída</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include('../layout/citizen-footer') %>
