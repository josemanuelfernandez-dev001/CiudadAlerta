<%- include('../layout/header') %>

<section class="page-header">
  <h2>Reportes ciudadanos</h2>
  <div>
    <a class="btn-primary" href="/reportes/mapa">Ver mapa</a>
    <% if (usuario) { %>
      <a class="btn-primary" href="/reportes/nuevo">Nuevo reporte</a>
    <% } %>
  </div>
</section>

<form class="filtros" method="GET" action="/reportes">
  <input
    type="text"
    name="zona"
    placeholder="Filtrar por zona"
    value="<%= filtros?.zona || '' %>"
  />

  <select name="estado">
    <option value="">Todos los estados</option>
    <% ['pendiente', 'en_proceso', 'resuelto', 'rechazado'].forEach(estado => { %>
      <option value="<%= estado %>" <%= filtros?.estado === estado ? 'selected' : '' %>>
        <%= estado.replace('_', ' ') %>
      </option>
    <% }) %>
  </select>

  <select name="categoria_id">
    <option value="">Todas las categorías</option>
    <% (categorias || []).forEach(c => { %>
      <option value="<%= c.id %>" <%= String(filtros?.categoria_id || '') === String(c.id) ? 'selected' : '' %>>
        <%= c.nombre %>
      </option>
    <% }) %>
  </select>

  <button type="submit">Filtrar</button>
</form>

<% if (!reportes || reportes.length === 0) { %>
  <p class="empty">Aún no hay reportes para estos filtros.</p>
<% } else { %>
  <section class="reportes-grid">
    <% reportes.forEach(r => { %>
      <% const votosCount = Array.isArray(r.votos) ? (r.votos[0]?.count ?? r.votos.length) : 0; %>
      <a class="reporte-card" href="/reportes/<%= r.id %>">
        <span class="card-estado estado-<%= r.estado %>"><%= r.estado.replace('_', ' ') %></span>
        <h3><%= r.titulo %></h3>
        <p class="card-meta">
          <% if (r.categorias?.color_hex) { %>
            <span class="cat-dot" style="background:<%= r.categorias.color_hex %>"></span>
          <% } %>
          <%= r.categorias?.nombre || 'Sin categoría' %>
          <% if (r.zona) { %> · <%= r.zona %><% } %>
        </p>
        <p class="card-fecha"><%= new Date(r.created_at).toLocaleDateString('es-BO') %></p>
        <p class="card-votos">Votos: <%= votosCount %></p>
      </a>
    <% }) %>
  </section>
<% } %>

<%- include('../layout/footer') %>