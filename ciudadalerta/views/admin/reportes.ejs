<%- include('./layout/admin-header') %>

<section class="admin-hero">
  <div>
    <h1>Gestión de reportes</h1>
    <p>Filtra, actualiza estados y gestiona moderación.</p>
  </div>
</section>

<%- include('../shared/components/report-filters', { action: '/admin/reportes', categorias, filtros, submitLabel: 'Filtrar', allStatesLabel: 'Todos', showZona: true }) %>

<section class="panel">
  <table class="tabla-admin">
    <thead><tr><th>Título</th><th>Estado</th><th>Zona</th><th>Votos</th><th>Fecha</th><th>Moderación</th></tr></thead>
    <tbody>
    <% if (!reportes || reportes.length === 0) { %>
      <tr><td colspan="6" class="empty">No hay reportes para mostrar.</td></tr>
    <% } %>
    <% (reportes || []).forEach(r => { %>
      <% const votosCount = Array.isArray(r.votos) ? (r.votos[0]?.count ?? r.votos.length) : 0; %>
      <tr>
        <td><a href="/reportes/<%= r.id %>"><%= r.titulo %></a></td>
        <td><%- include('../shared/components/status-badge', { estado: r.estado, showDot: false }) %></td>
        <td><%= r.zona || '—' %></td>
        <td><%= votosCount %></td>
        <td><%= new Date(r.created_at).toLocaleDateString('es-BO') %></td>
        <td>
          <form class="inline-form" action="/admin/reportes/<%= r.id %>/estado" method="POST">
            <select name="estado" required>
              <% ['pendiente', 'en_proceso', 'resuelto', 'rechazado'].forEach(estado => { %>
                <option value="<%= estado %>" <%= r.estado === estado ? 'selected' : '' %>><%= estado.replace('_', ' ') %></option>
              <% }) %>
            </select>
            <input type="text" name="area_asignada" placeholder="Área" value="<%= r.area_asignada || '' %>" />
            <input type="text" name="comentario" placeholder="Comentario" />
            <button class="btn" type="submit">Guardar</button>
          </form>
          <form action="/admin/reportes/<%= r.id %>/eliminar" method="POST">
            <button class="btn-danger" type="submit" onclick="return confirm('¿Seguro que deseas eliminar este reporte?');">Eliminar</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</section>

<%- include('./layout/admin-footer') %>
