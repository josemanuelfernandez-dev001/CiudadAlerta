<%- include('../layout/admin-header') %>

<section class="admin-hero">
  <div>
    <h1>Dashboard municipal</h1>
    <p>Panorama operativo de incidencias ciudadanas.</p>
  </div>
  <a class="btn" href="/admin/reportes">Gestionar reportes</a>
</section>

<section class="metrics">
  <article class="metric"><strong><%= stats?.total || 0 %></strong><small>Total</small></article>
  <article class="metric"><strong><%= stats?.pendientes || 0 %></strong><small>Pendientes</small></article>
  <article class="metric"><strong><%= stats?.en_proceso || 0 %></strong><small>En proceso</small></article>
  <article class="metric"><strong><%= stats?.resueltos || 0 %></strong><small>Resueltos</small></article>
  <article class="metric"><strong><%= stats?.rechazados || 0 %></strong><small>Rechazados</small></article>
</section>

<section class="panel">
  <h2>Pendientes más antiguos</h2>
  <table class="tabla-admin">
    <thead><tr><th>Título</th><th>Zona</th><th>Fecha</th><th>Acción</th></tr></thead>
    <tbody>
    <% if (!antiguos || antiguos.length === 0) { %>
      <tr><td colspan="4" class="empty">No hay reportes pendientes.</td></tr>
    <% } %>
    <% (antiguos || []).forEach(r => { %>
      <tr>
        <td><%= r.titulo %></td>
        <td><%= r.zona || '—' %></td>
        <td><%= new Date(r.created_at).toLocaleDateString('es-BO') %></td>
        <td><a href="/reportes/<%= r.id %>">Ver</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</section>

<%- include('../layout/admin-footer') %>
